{
  "name": "logicfit",
  "version": "0.1.0",
  "private": true,
  "description": "LogicFit local-first platform foundation",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "dotnet run --project src/LogicFit.Api/LogicFit.Api.csproj --no-launch-profile --environment Development --urls http://127.0.0.1:5199",
    "dev:web": "npm --workspace @logicfit/web run dev",
    "build": "dotnet build LogicFit.sln --nologo && npm run build:web",
    "build:web": "npm --workspace @logicfit/web run build",
    "test": "dotnet test LogicFit.sln --nologo && npm run test:web && npm run test:mobile",
    "test:web": "npm --workspace @logicfit/web run test",
    "test:mobile": "cd apps\\mobile && flutter test",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "npm --workspace @logicfit/web run typecheck",
    "lint": "npm run lint:web",
    "lint:web": "npm --workspace @logicfit/web run lint",
    "validate:seed": "node tools/seed/validate-seeds.js",
    "migration:apply:local": "dotnet run --project src/LogicFit.Api/LogicFit.Api.csproj --no-launch-profile --environment Development --urls http://127.0.0.1:5199 -- --migrate",
    "seed:local": "dotnet run --project src/LogicFit.Api/LogicFit.Api.csproj --no-launch-profile --environment Development --urls http://127.0.0.1:5199 -- --seed",
    "seed:verify": "dotnet run --project src/LogicFit.Api/LogicFit.Api.csproj --no-launch-profile --environment Development --urls http://127.0.0.1:5199 -- --verify-seed",
    "consistency:phase3": "node tools/seed/check-phase3-consistency.js",
    "consistency:phase4": "node tools/dev/check-phase4-consistency.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
