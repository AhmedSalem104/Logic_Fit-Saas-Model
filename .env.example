# Official backend: ASP.NET Core Web API / .NET 10 / EF Core / SQL Server.
# This file contains local defaults only; never add credentials or secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5199

LogicFit__SqlServer__Server=localhost
LogicFit__SqlServer__ControlPlaneDatabase=LogicFit_ControlPlane_Local
LogicFit__SqlServer__DefaultGymDatabase=LogicFit_Gym_001_Local
LogicFit__SqlServer__IntegratedSecurity=true
LogicFit__SqlServer__User=
LogicFit__SqlServer__Password=
LogicFit__SqlServer__TrustServerCertificate=true
LogicFit__SqlServer__Encrypt=false

LogicFit__Runtime__Environment=Development
LogicFit__Runtime__Version=0.1.0
LogicFit__Runtime__CorsOrigins=http://localhost:5173
LogicFit__Runtime__MfaIssuer=LogicFit
# Required for local MFA enrollment/verification. Generate a per-developer
# 32-byte Base64 key and keep the value only in the ignored local .env file:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
LogicFit__Runtime__MfaProtectionKeyBase64=

# Web and Flutter clients consume the same REST API.
VITE_API_BASE_URL=http://127.0.0.1:5199/api/v1
LOGICFIT_API_BASE_URL=http://127.0.0.1:5199/api/v1
