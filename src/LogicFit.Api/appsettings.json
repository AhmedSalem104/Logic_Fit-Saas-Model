{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LogicFit": {
    "SqlServer": {
      "Server": "localhost",
      "ControlPlaneDatabase": "LogicFit_ControlPlane_Local",
      "DefaultGymDatabase": "LogicFit_Gym_001_Local",
      "IntegratedSecurity": true,
      "TrustServerCertificate": true,
      "Encrypt": false
    },
    "Runtime": {
      "Environment": "Development",
      "Version": "0.1.0",
      "CorsOrigins": "http://localhost:5173",
      "MfaIssuer": "LogicFit"
    }
  },
  "AllowedHosts": "*"
}
